// Slurm overlay for pipelines that hard-code an executor or queue, or none at all.
// nextflow run <pipeline> -c conf/slurm.config --slurm_queue <partition> [--slurm_account <acct>]
params.slurm_queue = 'cpu'
params.slurm_account = null
params.slurm_time = '8h'
params.slurm_max_cpus = 16
params.slurm_max_memory = '64.GB'

process {
    executor = 'slurm'
    queue = params.slurm_queue
    clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : ''
    time = params.slurm_time
    shell = ['/bin/bash', '-euo', 'pipefail']
    resourceLimits = [cpus: params.slurm_max_cpus as int, memory: params.slurm_max_memory as nextflow.util.MemoryUnit]
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries = 1
}

executor {
    queueSize = 50
    submitRateLimit = '10/1min'
}
