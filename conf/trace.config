// Added by scripts/run_with_logs.sh. Nextflow's default trace fields plus attempt, which lets
// the summary tell a retry from a second task with the same tag, and each task's container.
trace {
    fields = 'task_id,hash,native_id,name,status,exit,attempt,container,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
