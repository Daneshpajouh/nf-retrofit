// Local overlay for small test runs: at most one CPU and 2 GB per task, and pipefail
// so a failing command inside a pipe fails the task. Apply with -c conf/test.config.
process {
    executor = 'local'
    // a cap, not a default: plain cpus and memory here lose to a pipeline's withLabel or withName
    resourceLimits = [cpus: 1, memory: 2.GB]
    shell = ['/bin/bash', '-euo', 'pipefail']
}

// The published images for both example pipelines are amd64 only.
// This replaces the pipeline's own docker.runOptions, such as a -u user mapping.
docker.runOptions = '--platform linux/amd64'
