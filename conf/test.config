// Local overlay for small test runs: one CPU per task, little memory, and pipefail
// so a failing command inside a pipe fails the task. Apply with -c conf/test.config.
process {
    executor = 'local'
    cpus = 1
    memory = 2.GB
    shell = ['/bin/bash', '-euo', 'pipefail']
}

// The published images for both example pipelines are amd64 only.
docker.runOptions = '--platform linux/amd64'
