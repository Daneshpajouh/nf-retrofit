nextflow_pipeline {

    name "CalliNGS-NF on its own bundled data"
    script "examples/callings-nf/main.nf"
    // modules.nf uses the `phase` operator, removed from current Nextflow; CI runs this
    // file with NXF_VER=22.04.5, the newest release tested that still has it (see .github/workflows/ci.yml)

    test("two replicates produce a final VCF") {
        when {
            params {
                results = "${outputDir}/results"
            }
        }
        then {
            assert workflow.success
            def vcfs = []
            new File("${outputDir}/results").eachFileRecurse { f ->
                if (f.name.endsWith('.vcf') || f.name.endsWith('.vcf.gz')) vcfs << f
            }
            assert vcfs
        }
    }
}
